[Unit]
Description=BuMaVory ZFS Manager pool capacity monitor (destructive cleanup disabled by default)
After=local-fs.target zfs.target
ConditionPathExists=/usr/lib/pve-zfs-manager/zfsm_emergency.py

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/lib/pve-zfs-manager/zfsm_emergency.py monitor
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pve-zfs-manager /run/lock
# Alert-only default; cleanup requires an explicit root-owned opt-in file.
